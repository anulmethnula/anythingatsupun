# Public base URLs only. Never add WooCommerce consumer secrets to VITE_* values.
# Leave empty to use local fallback data without making network requests.
VITE_WORDPRESS_API_BASE_URL=
VITE_WOOCOMMERCE_STORE_API_BASE_URL=

# Endpoint paths are intentionally blank until the backend contract is agreed.
VITE_WORDPRESS_HERO_ENDPOINT=
VITE_WORDPRESS_PROMO_BANNER_ENDPOINT=

# Must return JSON containing a non-negative integer in `viewerCount` or `count`.
# The frontend adds the current `productId` as a query parameter and refreshes every 30 seconds.
VITE_PRODUCT_VIEWERS_ENDPOINT=

# Optional public review submission/read endpoint. Keep blank until implemented.
VITE_WOOCOMMERCE_REVIEWS_ENDPOINT=
